# Copy to .env and fill in your values.

# SmugMug API credentials (obtain from https://api.smugmug.com/api/developer/apply)
SMUGLY_SMUGMUG_API_KEY=
SMUGLY_SMUGMUG_API_SECRET=

# Host path to your photo directory (used by docker-compose)
PHOTO_DIR=/nas/photos

# Internal paths (these are the defaults; override only if needed)
# SMUGLY_PHOTO_DIR=/photos
# SMUGLY_CONFIG_DIR=/config
# SMUGLY_PORT=8080
